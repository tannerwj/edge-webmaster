{
  "$schema": "./node_modules/@tjohnson/abacus/configs/abacus.schema.json",
  "preset": "cloudflare-worker",
  "check": {
    "gates": ["lint", "abc", "tsc", "deadcode", "secrets", "cycles", "dupes", "todos", "ratchet"]
  },
  "size": {
    "budgets": [
      { "label": "SPA JS (all chunks, gzip)", "dir": "web/dist/assets", "match": "\\.js$", "max": 286720 },
      { "label": "SPA largest JS chunk (gzip)", "dir": "web/dist/assets", "match": "\\.js$", "max": 266240, "mode": "largest" },
      { "label": "SPA CSS (gzip)", "dir": "web/dist/assets", "match": "\\.css$", "max": 20480 }
    ]
  },
  "roots": ["src", "scripts"],
  "tsc": { "projects": ["tsconfig.json", "web/tsconfig.json"] },
  "exclude": ["\\.d\\.ts$", "\\.test\\.tsx?$", "frontend\\.gen\\.ts$"],
  "abc": { "budget": 60, "allow": {} },
  "ratchet": {
    "file": "abacus.ratchet.json",
    "metrics": {
      "loc": { "roots": ["src"], "slack": 0.02 },
      "oxlintWarnings": true,
      "abcMax": true,
      "comments": { "roots": ["src"], "max": 0.3 }
    }
  }
}
