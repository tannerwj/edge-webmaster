{
  "$schema": "./node_modules/@tjohnson/abacus/configs/abacus.schema.json",
  "preset": "cloudflare-worker",
  "check": {
    "gates": ["lint", "abc", "tsc", "deadcode", "secrets", "cycles", "dupes", "todos", "ratchet"]
  },
  "roots": ["src", "scripts"],
  "tsc": { "projects": ["tsconfig.json", "web/tsconfig.json"] },
  "exclude": ["\\.d\\.ts$", "\\.test\\.tsx?$", "frontend\\.gen\\.ts$"],
  "abc": { "budget": 60, "allow": {} },
  "ratchet": {
    "file": "abacus.ratchet.json",
    "metrics": {
      "loc": { "roots": ["src"], "slack": 0.02 },
      "oxlintWarnings": true,
      "abcMax": true,
      "comments": { "roots": ["src"], "max": 0.3 }
    }
  }
}
