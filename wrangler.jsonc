{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-webmaster",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "MCP_MODE": "code",
    "PUBLIC_URL": "https://webmaster.tannerwj.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-webmaster",
      "database_id": "7ceb8e60-b239-45bb-9fcd-7e123c97c0f7",
      "migrations_dir": "migrations"
    }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "env": {
    "staging": {
      "name": "edge-webmaster-staging",
      "workers_dev": false,
      "vars": {
        "MCP_MODE": "code",
        "PUBLIC_URL": "https://webmaster-staging.tannerwj.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "edge-webmaster-staging",
          "database_id": "7ba423bc-d453-4b06-a971-eea60a29d794",
          "migrations_dir": "migrations"
        }
      ],
      "worker_loaders": [{ "binding": "LOADER" }]
    }
  }
}
